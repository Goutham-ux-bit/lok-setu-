# Server
PORT=3000
NODE_ENV=development

# Auth
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d

# Admin key - required in the "x-admin-key" header to update a report's status
ADMIN_KEY=change_this_admin_key

# Database (SQLite file path, relative to backend/)
DB_PATH=./database/loksetu.db

# CORS - comma separated list of allowed origins. Use * for any (dev only).
CORS_ORIGIN=*
